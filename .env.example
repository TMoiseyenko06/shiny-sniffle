# LongCat GUI settings. Edit, then run ./restart.sh

# Port the server listens on (0.0.0.0:PORT). In vast.ai, open this port in the instance's
# docker options (for example -p 8000:8000); vast.ai maps it to a random external port.
PORT=8000

# Login password. setup.sh writes a random one here. If empty, the server makes up a new one
# on every start and prints it in server.log.
GUI_PASSWORD=

# longcat = the real model. mock = fake CPU backend for testing the interface without a GPU.
BACKEND=longcat

# GPU memory strategy: auto | none | text_encoder | blocks
#   auto: >=70 GB VRAM -> none (all weights resident)
#         >=40 GB      -> text_encoder (UMT5 encoder waits in CPU RAM, KV cache offloaded)
#         smaller      -> blocks (also swaps DiT blocks from CPU RAM and tiles the VAE; slow)
OFFLOAD=auto
# VRAM kept free for activations when OFFLOAD=blocks decides how many DiT blocks stay on the GPU
ACTIVATION_RESERVE_GB=10

# Resolutions offered in the UI: auto | 480p | 720p
#   auto: 720p is offered from 40 GB of VRAM and is the default from 70 GB
DEFAULT_RESOLUTION=auto
MAX_RESOLUTION=auto

# Denoising steps of the 720p refinement pass (official demo value; it runs the last half of them)
REFINE_STEPS=50
# CFG scale used by Quality mode
GUIDANCE_SCALE=4.0
# 1 = torch.compile the DiT: faster steps after a slow first run, recompiles for new shapes
ENABLE_COMPILE=0

# Upload size limit in MB
MAX_UPLOAD_MB=25

# Paths (defaults: next to server.py)
# DATA_DIR=/workspace/longcat-gui
# MODEL_DIR=/workspace/longcat-gui/models/LongCat-Video
# LONGCAT_REPO=/workspace/longcat-gui/LongCat-Video
